{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kalm specification map",
  "description": "Maps Kalm language specification series to their source documents.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "latestSeries", "documents"],
  "properties": {
    "$schema": {
      "const": "./schema/map.schema.json"
    },
    "schemaVersion": {
      "const": 2
    },
    "latestSeries": {
      "$ref": "#/$defs/series"
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/document"
      }
    }
  },
  "$defs": {
    "series": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["majorMinor", "specificationVersion", "status", "file"],
      "properties": {
        "majorMinor": {
          "$ref": "#/$defs/series"
        },
        "specificationVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-draft)?$"
        },
        "status": {
          "enum": ["draft", "final"]
        },
        "file": {
          "type": "string",
          "pattern": "^documents/v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-draft)?\\.md$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "draft"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "specificationVersion": {
                "pattern": "-draft$"
              },
              "file": {
                "pattern": "-draft\\.md$"
              }
            }
          },
          "else": {
            "properties": {
              "specificationVersion": {
                "not": {
                  "pattern": "-draft$"
                }
              },
              "file": {
                "not": {
                  "pattern": "-draft\\.md$"
                }
              }
            }
          }
        }
      ]
    }
  }
}
