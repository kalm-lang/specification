{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kalm specification front matter",
  "description": "Metadata at the start of a Kalm language specification Markdown document.",
  "type": "object",
  "required": [
    "$schema",
    "title",
    "version",
    "status",
    "date",
    "lastmod",
    "javaversion",
    "revision"
  ],
  "properties": {
    "$schema": {
      "const": "../schemas/frontmatter.schema.json",
      "description": "Relative path to this schema from the Markdown document."
    },
    "title": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "status": { "enum": ["draft", "final"] },
    "date": { "type": "string", "format": "date" },
    "lastmod": { "type": "string", "format": "date" },
    "javaversion": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "revision": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": {
    "type": ["string", "number", "boolean", "null"]
  }
}
