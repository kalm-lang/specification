{
  "name": "@kalm-lang/specification",
  "version": "1.2.0",
  "description": "Static, versioned Kalm language specifications",
  "license": "MIT",
  "homepage": "https://kalm.tcraft.link/",
  "bugs": {
    "url": "https://github.com/kalm-lang/specification/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kalm-lang/specification"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:index": "node scripts/generate-index.mjs",
    "build:pdfs": "node scripts/build-pdfs.mjs",
    "build:packages": "node scripts/build-packages.mjs",
    "test": "node --test",
    "test:pdfs": "node --test tests/pdf-layout.test.mjs tests/pdf-pagination.test.mjs tests/code-highlighting.test.mjs",
    "release:resolve": "node scripts/resolve-release-version.mjs",
    "release:github": "node scripts/create-release.mjs"
  },
  "main": "./generated/package-api/index.cjs",
  "module": "./generated/package-api/index.mjs",
  "types": "./generated/package-api/index.d.ts",
  "exports": {
    ".": {
      "types": "./generated/package-api/index.d.ts",
      "import": "./generated/package-api/index.mjs",
      "require": "./generated/package-api/index.cjs"
    },
    "./schema": "./validation/frontmatter.schema.json",
    "./schemas/frontmatter.schema.json": "./validation/frontmatter.schema.json",
    "./versions/*": {
      "types": "./generated/versions/*.d.mts",
      "import": "./generated/versions/*.mjs"
    },
    "./drafts/*": {
      "types": "./generated/drafts/*.d.mts",
      "import": "./generated/drafts/*.mjs"
    },
    "./documents/*": "./documents/*",
    "./validation/frontmatter.schema.json": "./validation/frontmatter.schema.json",
    "./validation/frontmatter.cjs": "./validation/frontmatter.cjs",
    "./changes/*.md": "./changes/*.md",
    "./changes/*": {
      "types": "./generated/changes/*.d.mts",
      "import": "./generated/changes/*.mjs"
    }
  },
  "files": [
    "generated/package-api/",
    "validation/",
    "documents/",
    "generated/pdf/",
    "generated/versions/",
    "generated/drafts/",
    "README.md",
    "LICENSE",
    "changes/",
    "generated/changes/"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "marked": "17.0.5",
    "pdf-lib": "1.17.1",
    "@kalm-lang/syntax-highlighting": "1.2.0"
  }
}
