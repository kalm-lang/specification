{
  "name": "@kalm-lang/specification",
  "version": "1.0.0",
  "description": "Versioned Kalm language specifications and lookup API",
  "license": "MIT",
  "homepage": "https://kalm.tcraft.link/",
  "bugs": {
    "url": "https://github.com/kalm-lang/specification/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kalm-lang/specification.git"
  },
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./map": "./map.json",
    "./schema": "./schemas/map.schema.json",
    "./versions/*": {
      "types": "./versions/*.d.mts",
      "import": "./versions/*.mjs"
    },
    "./drafts/*": {
      "types": "./drafts/*.d.mts",
      "import": "./drafts/*.mjs"
    },
    "./documents/*": "./documents/*"
  },
  "files": [
    "index.cjs",
    "index.mjs",
    "index.d.ts",
    "map.json",
    "schemas/",
    "documents/",
    "versions/",
    "drafts/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=20.18.0"
  }
}
