{
  "name": "@kalm-lang/specification",
  "version": "1.0.0",
  "description": "Static, versioned Kalm language specifications",
  "license": "MIT",
  "homepage": "https://kalm.tcraft.link/",
  "bugs": {
    "url": "https://github.com/kalm-lang/specification/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kalm-lang/specification.git"
  },
  "type": "module",
  "scripts": {
    "build:pdfs": "node scripts/build-pdfs.mjs",
    "test:pdfs": "node --test tests/pdf-layout.test.mjs tests/pdf-pagination.test.mjs"
  },
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./schema": "./schemas/frontmatter.schema.json",
    "./schemas/frontmatter.schema.json": "./schemas/frontmatter.schema.json",
    "./versions/*": {
      "types": "./versions/*.d.mts",
      "import": "./versions/*.mjs"
    },
    "./drafts/*": {
      "types": "./drafts/*.d.mts",
      "import": "./drafts/*.mjs"
    },
    "./documents/*": "./documents/*"
  },
  "files": [
    "index.cjs",
    "index.mjs",
    "index.d.ts",
    "schemas/",
    "documents/",
    "pdf/",
    "versions/",
    "drafts/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "marked": "17.0.5",
    "pdf-lib": "1.17.1"
  }
}
